          "responseLines": 7,
          "answer": {
            "value": "70082040；800000與80000；800000－80000＝720000；70082040＞7080040。",
            "explanation": "新數八位，比較的另一數七位，最高非零位不同。",
            "scoring": [
              {
                "points": 4,
                "criterion": "70082040。"
