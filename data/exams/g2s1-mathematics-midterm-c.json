            "g2s1-mathematics-01"
          ],
          "prompt": "三張數字卡各用一次，排一個100到200之間、而且超過150的數。寫出這個數，再說0在這裡表示什麼。",
          "responseLines": 3,
          "answer": {
            "value": "160；0在個位，表示沒有額外的單個。",
            "explanation": "百位必須1；106沒有超過150，因此符合的排列是160。",
            "scoring": [
              {
                "points": 6,
                "criterion": "排160得6分。"
              },
              {
                "points": 4,
                "criterion": "說0表示0個一或沒有額外單個得4分；只說沒有任何東西不得此項分。"
              }
            ]
          },
          "stimulus": "數字卡：1、0、6。每張只用一次，不能另加數字。",
          "id": "g2s1-mathematics-midterm-c-q01"
        },
        {
          "kind": "short",
          "points": 10,
          "difficulty": "reason",
          "scope": "main",
          "topicIds": [
            "g2s1-mathematics-01"
          ],
          "prompt": "這排每次往前數1，填空。再從140、144中選較大的數，說明為什麼。",
          "responseLines": 3,
          "answer": {
            "value": "空格140；144較大，百位和十位相同，比個位4與0。",
            "explanation": "142、141、140、139依序少1；140與144的百位、十位相同，再比個位。",
            "scoring": [
              {
                "points": 4,
                "criterion": "填140得4分。"
              },
              {
                "points": 2,
                "criterion": "選144較大得2分。"
              },
              {
                "points": 4,
                "criterion": "指出百、十位相同而4個一大於0個一，或其他正確位值比較得4分。"
              }
            ]
          },
          "stimulus": "倒數標籤：142、141、＿＿、139。",
          "id": "g2s1-mathematics-midterm-c-q02"
        }
